# Что значит каждая функция и
# Как будет собираться докер образ?
# Какие команды для сборки и запуска контейнера?
# - команда для запуска контейнера тут отсутствует
# - не совсем понимаю про сборку контейнера
# - Тут мы готовим снимок, который будет использоваться в контейнере

# Подтягиваем готовый образ
# назначем тег builder
FROM golang:1.17 AS builder

# Создаем рабочую директорию
WORKDIR /app

# Копируем файлы в текущую директорию образа
COPY go.mod go.sum ./

# Подтягиваем зависимости
RUN go mod download

# Копируем все в текующую директорию
COPY . .

# собираем в бинарник в наш проект
RUN go build -o myapp .

# используем multi stage build
# В готовый легковесный образ линукса копируем бинарник и назначаем команду, которая будет использоавться при запуске контейнера
FROM alpine:latest

WORKDIR /root/

COPY --from=builder /app/myapp .

CMD ["./myapp"]